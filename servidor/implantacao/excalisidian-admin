#!/usr/bin/env bash
# servidor/implantacao/excalisidian-admin
# Atalho para administrar contas na VPS (doc 18 §4): roda dist/admin.js como o usuário de
# sistema `excalisidian`, com o mesmo ambiente do serviço (mesma pasta de dados). Instalação:
# ver servidor/LEIAME.md ("comando que muda a VPS": copiar para /usr/local/bin e dar +x).
#
# Uso: excalisidian-admin premium <email>     (premium, 3.000 creditos de IA por mes)
#      excalisidian-admin superior <email>    (premium, 10.000 creditos de IA por mes)
#      excalisidian-admin gratis <email>
#      excalisidian-admin contas
#      excalisidian-admin uso <email>
#      excalisidian-admin vaults <email>
#      excalisidian-admin apagar-vault <email> <id>
set -euo pipefail

exec sudo --user=excalisidian --set-home \
	env EXCALISIDIAN_DADOS=/var/lib/excalisidian NODE_ENV=production \
	/usr/bin/node /opt/excalisidian/dist/admin.js "$@"
