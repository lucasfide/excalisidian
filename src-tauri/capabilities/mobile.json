{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permissões do vault local na aplicação mobile.",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "store:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    "core:app:allow-version"
  ]
}
